# Base URL of the Django REST API. No trailing slash.
# The browser calls this directly, so it must be reachable from the host,
# not from inside the frontend container.
VITE_API_BASE_URL=http://localhost:8000

# Set to "true" when running the dev server inside Docker on macOS/Windows,
# where bind mounts do not deliver filesystem events.
VITE_USE_POLLING=false
